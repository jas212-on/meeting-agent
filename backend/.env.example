PORT=3001
MONGODB_URI=your_mongodb_connection_uri
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Google Drive Recording Storage (Optional) ────────────
# Option A: Service Account (Recommended for automated bot uploads)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# Or inline JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option B: OAuth2 User Account
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token

# Target Google Drive Folder ID (optional, uploads to root if empty)
# GOOGLE_DRIVE_FOLDER_ID=your_shared_drive_folder_id

